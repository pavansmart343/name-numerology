      11: { title: "O Visionário", planet: "🌙 Lua + ☀️ Sol", element: "Todos", color: "#f59e0b", emoji: "✨", keywords: ["Inspirador","Intuitivo","Idealista","Sensível","Iluminado"], luckyColors: "Prata, Ouro, Branco", luckyDays: "Domingo, Segunda", compatible: [2, 11, 22], description: "Você carrega um Número Mestre. Seu nome ressoa com extraordinária intuição espiritual." },
      22: { title: "O Mestre Construtor", planet: "♀ Vênus + ♄ Saturno", element: "Terra", color: "#8b5cf6", emoji: "🏗️", keywords: ["Visionário","Disciplinado","Magistral","Ambicioso","Prático"], luckyColors: "Roxo, Ouro, Tons de Terra", luckyDays: "Sábado, Sexta", compatible: [4, 8, 22], description: "O 22 é o número mais poderoso da numerologia. Seu nome carrega a vibração do Mestre Construtor." },
      33: { title: "O Mestre Professor", planet: "♃ Júpiter + ♀ Vênus", element: "Todos", color: "#10b981", emoji: "🕊️", keywords: ["Nutridor","Amoroso","Inspirador","Curador","Dedicado"], luckyColors: "Ouro, Verde Claro, Branco", luckyDays: "Quinta, Sexta", compatible: [6, 11, 33], description: "O mais raro de todos os Números Mestres. Sua missão é elevar a humanidade através da compaixão." },
    };

    function reduce(n: number): number {
      while (n > 9 && n !== 11 && n !== 22 && n !== 33)
        n = String(n).split('').reduce((s,d) => s + parseInt(d), 0);
      return n;
    }

    function nameToNumber(name: string) {
      const clean = name.toLowerCase().replace(/[^a-z]/g,'');
      let total = 0; let parts: string[] = []; let letters: {l:string,v:number}[] = [];
      for (const c of clean) {
        const v = chaldean[c] ?? 0;
        if (v) { total += v; parts.push(`${v}`); letters.push({l:c.toUpperCase(),v}); }
      }
      return { total: reduce(total), rawSum: total, parts, letters };
    }

    const compat: Record<string, number> = {
      '1-1':70,'1-2':60,'1-3':80,'1-4':75,'1-5':65,'1-6':55,'1-7':70,'1-8':85,'1-9':60,
      '2-3':65,'2-4':80,'2-5':50,'2-6':90,'2-7':75,'2-8':55,'2-9':70,
      '3-4':60,'3-5':85,'3-6':70,'3-7':65,'3-8':60,'3-9':80,
      '4-5':55,'4-6':85,'4-7':70,'4-8':75,'4-9':65,
      '5-6':60,'5-7':70,'5-8':65,'5-9':75,
      '6-7':65,'6-8':70,'6-9':90,'7-8':60,'7-9':70,'8-9':65,
    };

    function getCompat(n1: number, n2: number): { score: number; desc: string } {
      const key = [n1,n2].sort().join('-');
      const score = compat[key] ?? 65;
      let desc = '';
      if (score >= 85) desc = `🌟 Excelente compatibilidade! Estas vibrações criam uma parceria poderosa e harmoniosa.`;
      else if (score >= 70) desc = `✨ Boa compatibilidade. Estes nomes complementam-se bem e a relação cresce forte.`;
      else if (score >= 55) desc = `⚡ Compatibilidade moderada. Estas vibrações criam tensão dinâmica — desafiadora, mas que promove o crescimento.`;
      else desc = `🔥 Compatibilidade desafiadora. Estas energias podem entrar em conflito. Requer paciência e compreensão mútua.`;
      return { score, desc };
    }

    document.getElementById('nameHubForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const primaryInput = (document.getElementById('primaryName') as HTMLInputElement).value.trim();
      const partnerInput = (document.getElementById('partnerName') as HTMLInputElement).value.trim();
      if (!primaryInput) return;

      const { total: num1, rawSum, parts, letters } = nameToNumber(primaryInput);
      const data = numberData[num1] ?? numberData[9];

      const bigDisplay = document.getElementById('bigNumberDisplay') as HTMLElement;
      bigDisplay.textContent = `${data.emoji} ${num1}`;
      bigDisplay.style.backgroundColor = data.color;

      const banner = document.getElementById('numberCardBanner') as HTMLElement;
      banner.style.background = `linear-gradient(90deg, ${data.color}, transparent)`;

      (document.getElementById('numberTitle') as HTMLElement).textContent = `${num1} · ${data.title}`;
      (document.getElementById('nameLabel') as HTMLElement).textContent = `Análise para: ${primaryInput}`;
      (document.getElementById('numberDesc') as HTMLElement).textContent = data.description;

      const planetBadge = document.getElementById('planetBadge') as HTMLElement;
      planetBadge.textContent = data.planet;
      const elementBadge = document.getElementById('elementBadge') as HTMLElement;
      elementBadge.textContent = `Elemento ${data.element}`;

      const keywordPills = document.getElementById('keywordPills') as HTMLElement;
      keywordPills.innerHTML = data.keywords.map((k: string) =>
        `<span class="px-3 py-1 text-xs font-semibold rounded-full border themed-border themed-text-2">${k}</span>`
      ).join('');

      (document.getElementById('luckyColors') as HTMLElement).textContent = data.luckyColors;
      (document.getElementById('luckyDays') as HTMLElement).textContent = data.luckyDays;
      (document.getElementById('compatible') as HTMLElement).textContent = `Números ${data.compatible.join(', ')}`;
      (document.getElementById('chaldeanSum') as HTMLElement).textContent = `${parts.join(' + ')} = ${rawSum} → ${num1}`;

      const traitEmojis = ['💡','🎯','🧭','⚡','🌱'];
      const traitsEl = document.getElementById('personalityTraits') as HTMLElement;
      traitsEl.innerHTML = data.keywords.map((k: string, i: number) =>
        `<li class="flex items-center gap-3 p-3 rounded-xl bg-[var(--bg-secondary)] themed-text text-sm font-medium">
          <span class="text-lg">${traitEmojis[i % traitEmojis.length]}</span>
          ${k}
        </li>`
      ).join('');

      const letterEl = document.getElementById('letterBreakdown') as HTMLElement;
      letterEl.innerHTML = letters.map(({ l, v }) =>
        `<div class="flex flex-col items-center p-2 rounded-lg bg-[var(--bg-secondary)] min-w-[2.5rem]">
          <span class="text-sm font-bold themed-text">${l}</span>
          <span class="text-xs themed-text-3">${v}</span>
        </div>`
      ).join('');
      (document.getElementById('breakdownFormula') as HTMLElement).textContent = `${parts.join(' + ')} = ${rawSum} → reduzido para ${num1}`;

      const compatCard = document.getElementById('compatibilityCard') as HTMLElement;
      if (partnerInput) {
        const { total: num2 } = nameToNumber(partnerInput);
        const { score, desc } = getCompat(num1, num2);
        const data2 = numberData[num2] ?? numberData[9];

        (document.getElementById('name1Label') as HTMLElement).textContent = primaryInput.split(' ')[0];
        const n1Badge = document.getElementById('name1NumBadge') as HTMLElement;
        n1Badge.textContent = num1.toString();
        n1Badge.style.backgroundColor = data.color;

        (document.getElementById('name2Label') as HTMLElement).textContent = partnerInput.split(' ')[0];
        const n2Badge = document.getElementById('name2NumBadge') as HTMLElement;
        n2Badge.textContent = num2.toString();
        n2Badge.style.backgroundColor = data2.color;

        (document.getElementById('compatPercent') as HTMLElement).textContent = `${score}% de Combinação`;
        (document.getElementById('compatibilityDesc') as HTMLElement).textContent = desc;

        setTimeout(() => {
          (document.getElementById('compatBar') as HTMLElement).style.width = score + '%';
        }, 150);
        compatCard.classList.remove('hidden');
      } else {
        compatCard.classList.add('hidden');
      }

      const resultsSection = document.getElementById('resultsSection') as HTMLElement;
      resultsSection.classList.remove('hidden');
      setTimeout(() => resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
    });
  </script>
