                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="faq-answer hidden px-6 pb-5 text-zinc-400 text-sm leading-relaxed">
              {faq.answer}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script>
    const chaldean: Record<string, number> = {
      a:1,b:2,c:3,d:4,e:5,f:8,g:3,h:5,i:1,j:1,k:2,l:3,m:4,
      n:5,o:7,p:8,q:1,r:2,s:3,t:4,u:6,v:6,w:6,x:5,y:1,z:7
    };

    // Note: To pass the localized data to the script tag, we use a simple re-definition here.
    // In Astro, client-side scripts run in isolation unless we use define:vars.
    // For simplicity, we just inline the Portuguese data in the script.
