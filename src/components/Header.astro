---
const pathname = Astro.url.pathname;
const isPt = pathname.startsWith('/pt');
const pfx = isPt ? '/pt' : '';

// Calculate matching page for intelligent language switching
let enUrl = '/';
let ptUrl = '/pt/';

if (isPt) {
  const sub = pathname.replace(/^\/pt/, '') || '/';
  enUrl = sub;
  ptUrl = pathname;
} else {
  enUrl = pathname;
  const knownPtPages = [
    '/',
    '/name-analysis',
    '/name-analysis/',
    '/name-analyzer',
    '/name-analyzer/',
    '/life-path-calculator',
    '/life-path-calculator/',
    '/lucky-number-finder',
    '/lucky-number-finder/',
    '/soul-urge-calculator',
    '/soul-urge-calculator/',
    '/compatibility-calculator',
    '/compatibility-calculator/'
  ];
  if (knownPtPages.includes(pathname)) {
    ptUrl = `/pt${pathname === '/' ? '/' : pathname}`;
  } else {
    ptUrl = '/pt/';
  }
}

const navLinks = isPt
  ? [
      { name: 'Início', href: '/pt/' },
      { name: 'Analisador Solo', href: '/pt/name-analyzer' },
      { name: 'Central de Nomes', href: '/pt/name-analysis' },
      { name: 'Caminho de Vida', href: '/pt/life-path-calculator' },
      { name: 'Números da Sorte', href: '/pt/lucky-number-finder' },
      { name: 'Compatibilidade', href: '/pt/compatibility-calculator' },
      { name: 'Impulso da Alma', href: '/pt/soul-urge-calculator' },
    ]
  : [
      { name: 'Home', href: '/' },
      { name: 'Name Analyzer', href: '/name-analyzer' },
      { name: 'Name Hub', href: '/name-analysis' },
      { name: 'Life Path', href: '/life-path-calculator' },
      { name: 'Lucky Numbers', href: '/lucky-number-finder' },
      { name: 'Compatibility', href: '/compatibility-calculator' },
      { name: 'Soul Urge', href: '/soul-urge-calculator' },
    ];
---
<header class="sticky top-0 z-50 w-full border-b themed-border bg-[var(--bg-primary)]/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href={isPt ? "/pt/" : "/"} class="flex items-center gap-2.5 group">
      <img src="/favicon.svg" alt="Name Numerology Logo" class="w-8 h-8 group-hover:scale-110 transition-transform duration-200" />
      <span class="text-base font-bold tracking-tight themed-text hidden sm:block">
        Name<span class="gradient-text">Numerology</span>
        <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/20 ml-1">Hub</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-1">
      {navLinks.map((link) => (
        <a href={link.href} class="themed-text-2 hover:themed-text px-3 py-1.5 rounded-md text-sm font-medium transition-colors hover:bg-[var(--bg-secondary)]">
          {link.name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <!-- Language Switcher (Smart Context-Aware) -->
      <div class="flex items-center gap-1.5 text-xs font-bold border themed-border rounded-lg px-2.5 py-1.5 bg-[var(--bg-secondary)]">
        <a 
          href={enUrl} 
          class={`transition-colors ${!isPt ? 'text-purple-400 font-extrabold' : 'themed-text-3 hover:themed-text'}`}
          title="English Version"
        >
          EN
        </a>
        <span class="text-zinc-600">|</span>
        <a 
          href={ptUrl} 
          class={`transition-colors ${isPt ? 'text-purple-400 font-extrabold' : 'themed-text-3 hover:themed-text'}`}
          title="Versão em Português"
        >
          PT
        </a>
      </div>

      <!-- Theme Toggle -->
      <button
        id="themeToggle"
        aria-label="Toggle theme"
        class="w-9 h-9 flex items-center justify-center rounded-lg themed-border border themed-text-2 hover:themed-text hover:bg-[var(--bg-secondary)] transition-all duration-200"
      >
        <!-- Sun (shown in dark mode) -->
        <svg id="iconSun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <!-- Moon (shown in light mode) -->
        <svg id="iconMoon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>

      <!-- CTA button -->
      <a href={isPt ? "/pt/name-analysis" : "/name-analysis"} class="hidden sm:inline-flex h-9 items-center gap-1.5 justify-center rounded-lg bg-gradient-to-r from-purple-600 to-cyan-600 hover:from-purple-500 hover:to-cyan-500 px-3.5 text-xs font-semibold text-white transition-all duration-200 shadow-lg shadow-purple-500/20">
        {isPt ? "Análise do Nome" : "Free Calculator"}
      </a>

      <!-- Mobile hamburger -->
      <button id="mobileMenuBtn" class="lg:hidden w-9 h-9 flex items-center justify-center rounded-lg themed-border border themed-text-2 hover:themed-text" aria-label="Open menu">
        <svg id="iconHamburger" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg id="iconClose" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobileMenu" class="hidden lg:hidden border-t themed-border bg-[var(--bg-primary)]">
    <nav class="flex flex-col px-4 py-3 gap-1">
      {navLinks.map((link) => (
        <a href={link.href} class="themed-text-2 hover:themed-text py-2.5 px-3 rounded-lg hover:bg-[var(--bg-secondary)] transition-colors text-sm font-medium">
          {link.name}
        </a>
      ))}
      <a href={isPt ? "/pt/name-analysis" : "/name-analysis"} class="mt-2 text-center bg-gradient-to-r from-purple-600 to-cyan-600 text-white py-2.5 px-4 rounded-lg text-sm font-semibold">
        {isPt ? "Começar Análise do Nome" : "Start Full Analysis"}
      </a>
      <div class="mt-2 flex justify-center gap-4 text-sm font-semibold border-t themed-border pt-3">
        <a href={enUrl} class={`transition-colors ${!isPt ? 'text-purple-400 font-bold' : 'themed-text-2 hover:themed-text'}`}>English (EN)</a>
        <span class="text-zinc-600">|</span>
        <a href={ptUrl} class={`transition-colors ${isPt ? 'text-purple-400 font-bold' : 'themed-text-2 hover:themed-text'}`}>Português (PT)</a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile menu
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');
  const iconHam = document.getElementById('iconHamburger');
  const iconX = document.getElementById('iconClose');
  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconHam?.classList.toggle('hidden', !isOpen);
    iconX?.classList.toggle('hidden', isOpen);
  });

  // Theme toggle
  const themeBtn = document.getElementById('themeToggle');
  const sunIcon = document.getElementById('iconSun');
  const moonIcon = document.getElementById('iconMoon');
  const html = document.documentElement;

  function applyTheme(theme: string) {
    html.setAttribute('data-theme', theme);
    try { localStorage.setItem('nnh-theme', theme); } catch(e) {}
    if (theme === 'dark') {
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
    } else {
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
    }
  }

  // Init icon state
  const currentTheme = html.getAttribute('data-theme') || 'dark';
  applyTheme(currentTheme);

  themeBtn?.addEventListener('click', () => {
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    applyTheme(next);
  });
</script>
