---
const pathname = Astro.url.pathname;
const isPt = pathname.startsWith('/pt');
const pfx = isPt ? '/pt' : '';
---
<footer class="border-t themed-border themed-bg-2 mt-20">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="col-span-2 md:col-span-1">
        <a href={isPt ? "/pt/" : "/"} class="flex items-center gap-2 group">
          <img src="/favicon.svg" alt="Name Numerology Logo" class="w-7 h-7 group-hover:scale-110 transition-transform duration-200" />
          <span class="text-base font-bold tracking-tight">
            <span class="themed-text">Name</span><span class="gradient-text">Numerology</span>
            <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/20 ml-1">Hub</span>
          </span>
        </a>
        <p class="mt-3 text-sm themed-text-3 max-w-xs leading-relaxed">
          {isPt
            ? 'Ferramentas gratuitas de numerologia Chaldeu para desvendar os segredos do seu nome e do seu destino.'
            : "Free Chaldean numerology tools to discover the hidden meanings in your name and unlock your life's potential."}
        </p>
      </div>

      <div>
        <h3 class="text-xs font-semibold themed-text uppercase tracking-wider mb-4">
          {isPt ? 'Calculadoras' : 'Calculators & Hub'}
        </h3>
        <ul class="space-y-2.5">
          <li><a href={`${pfx}/name-analysis`} class="text-sm themed-text-2 hover:themed-text transition-colors">{isPt ? 'Análise do Nome Chaldeu' : 'Chaldean Name Hub'}</a></li>
          <li><a href={`${pfx}/life-path-calculator`} class="text-sm themed-text-2 hover:themed-text transition-colors">{isPt ? 'Caminho de Vida' : 'Life Path Calculator'}</a></li>
          <li><a href={`${pfx}/lucky-number-finder`} class="text-sm themed-text-2 hover:themed-text transition-colors">{isPt ? 'Números da Sorte' : 'Lucky Number Finder'}</a></li>
          <li><a href={`${pfx}/compatibility-calculator`} class="text-sm themed-text-2 hover:themed-text transition-colors">{isPt ? 'Compatibilidade Amorosa' : 'Compatibility Matcher'}</a></li>
          <li><a href={`${pfx}/soul-urge-calculator`} class="text-sm themed-text-2 hover:themed-text transition-colors">{isPt ? 'Impulso da Alma' : 'Soul Urge Calculator'}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold themed-text uppercase tracking-wider mb-4">
          {isPt ? 'Artigos & Recursos' : 'Resources & Guides'}
        </h3>
        <ul class="space-y-2.5">
          <li><a href="/articles/chaldean-vs-pythagorean-numerology" class="text-sm themed-text-2 hover:themed-text transition-colors">{isPt ? 'Chaldeu vs Pitagórico' : 'Chaldean vs Pythagorean'}</a></li>
          <li><a href="/articles/baby-name-meaning-finder" class="text-sm themed-text-2 hover:themed-text transition-colors">{isPt ? 'Nomes de Bebê' : 'Baby Name Meanings'}</a></li>
          <li><a href="/articles/astrological-name-analysis" class="text-sm themed-text-2 hover:themed-text transition-colors">{isPt ? 'Análise Astrológica' : 'Astrological Analysis'}</a></li>
          <li><a href="/faq" class="text-sm themed-text-2 hover:themed-text transition-colors">FAQ</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold themed-text uppercase tracking-wider mb-4">
          {isPt ? 'Institucional' : 'Company & Legal'}
        </h3>
        <ul class="space-y-2.5">
          <li><a href="/about" class="text-sm themed-text-2 hover:themed-text transition-colors">{isPt ? 'Sobre Nós' : 'About Us'}</a></li>
          <li><a href="/contact" class="text-sm themed-text-2 hover:themed-text transition-colors">{isPt ? 'Contato' : 'Contact Us'}</a></li>
          <li><a href="/privacy-policy" class="text-sm themed-text-2 hover:themed-text transition-colors">{isPt ? 'Privacidade' : 'Privacy Policy'}</a></li>
          <li><a href="/terms-and-conditions" class="text-sm themed-text-2 hover:themed-text transition-colors">{isPt ? 'Termos' : 'Terms & Conditions'}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t themed-border pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs themed-text-3">
        &copy; {new Date().getFullYear()} Name Numerology Hub · <a href="https://namenumerologyhub.com" class="hover:themed-text transition-colors">namenumerologyhub.com</a>
      </p>
      <div class="flex flex-wrap justify-center gap-5 text-xs themed-text-3">
        <a href={isPt ? "/pt/" : "/"} class="hover:themed-text transition-colors">{isPt ? 'Início' : 'Home'}</a>
        <a href={`${pfx}/name-analysis`} class="hover:themed-text transition-colors">{isPt ? 'Calculadora' : 'Calculator'}</a>
        <a href="/privacy-policy" class="hover:themed-text transition-colors">Privacy</a>
        <a href="/terms-and-conditions" class="hover:themed-text transition-colors">Terms</a>
        <a href="/faq" class="hover:themed-text transition-colors">FAQ</a>
      </div>
    </div>
  </div>
</footer>
